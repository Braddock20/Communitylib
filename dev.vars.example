# Local dev only (wrangler dev). Not needed for the dashboard-only
# workflow described in README.md -- kept here for reference / in case
# you ever do have CLI access again.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=

DEBUG_KEY=
ADMIN_API_KEY=
AI_MODEL="@cf/meta/llama-3.1-8b-instruct-fast"
AI_PUBLIC_ENABLED=false
PDF_PROCESSING_ENABLED=false
IMAGE_PDF_COMBINE_ENABLED=false

MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=20
MAX_TOTAL_UPLOAD_MB=25
APP_NAME="University of Eldoret Student Resources"
APP_VERSION="4.0.0"
